// https://zed.dev/docs/configuring-zed
// @see `zed: open default settings`
{
	"agent_servers": {
		"codex-acp": {
			"type": "registry"
		},
		"claude-acp": {
			"default_config_options": {
				"effort": "medium",
				"mode": "auto",
				"model": "sonnet"
			},
			"type": "registry"
		}
	},
	// "edit_predictions": {
	// 	"provider": "open_ai_compatible_api",
	// 	"open_ai_compatible_api": {
	// 		"api_url": "http://127.0.0.1:8080/v1/completions",
	// 		"model": "sweepai_sweep-next-edit-1.5B_sweep-next-edit-1.5b.q8_0.v2.gguf",
	// 		"prompt_format": "sweep",
	// 		"max_output_tokens": 512
	// 	}
	// },
	"edit_predictions": {
		"provider": "zed"
	},
	"project_panel": {
		"dock": "left"
	},
	"outline_panel": {
		"dock": "left"
	},
	"collaboration_panel": {
		"dock": "left"
	},
	"git_panel": {
		"dock": "left"
	},
	"helix_mode": false,
	"base_keymap": "Zed",
	"icon_theme": {
		"mode": "dark",
		"light": "Catppuccin Mocha",
		"dark": "Catppuccin Mocha"
	},
	"theme": "Catppuccin Mocha",
	"buffer_font_family": "CommitMono",
	// "buffer_font_size": 14,
	"buffer_font_weight": 300,
	// "buffer_font_features": {
	// 	"calt": false
	// },
	// "show_whitespaces": "boundary",
	"diagnostics": {
		"inline": {
			"enabled": true
		}
	},
	"inlay_hints": {
		"enabled": true,
		"show_value_hints": true,
		"toggle_on_modifiers_press": {
			"alt": true,
			"control": true
		}
	},
	"code_lens": "on",
	"minimap": {
		"show": "auto"
	},
	"wrap_guides": [80, 100, 120],
	"soft_wrap": "editor_width",
	"agent": {
		"dock": "right",
		"play_sound_when_agent_done": "when_hidden",
		"use_modifier_to_send": true
	},
	"formatter": "language_server",
	"languages": {
		"CSS": {
			"code_actions_on_format": {
				"source.organizeImports": true,
				"source.organizeImports.biome": true,
				"source.fixAll": true,
				"source.fixAll.biome": true
			},
			"formatter": { "language_server": { "name": "biome" } },
			"prettier": { "allowed": false }
		},
		"JSON": {
			"code_actions_on_format": {
				"source.organizeImports": true,
				"source.organizeImports.biome": true,
				"source.fixAll": true,
				"source.fixAll.biome": true
			},
			"formatter": { "language_server": { "name": "biome" } },
			"prettier": { "allowed": false }
		},
		"JSONC": {
			"code_actions_on_format": {
				"source.organizeImports": true,
				"source.organizeImports.biome": true,
				"source.fixAll": true,
				"source.fixAll.biome": true
			},
			"formatter": { "language_server": { "name": "biome" } },
			"prettier": { "allowed": false }
		},
		"Markdown": {
			"soft_wrap": "bounded",
			"prettier": { "allowed": false }
		},
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls",
				"!typescript-language-server",
				"..."
			],
			"code_actions_on_format": {
				"source.organizeImports": true,
				"source.organizeImports.biome": true,
				"source.fixAll": true,
				"source.fixAll.biome": true
			},
			"formatter": { "language_server": { "name": "biome" } },
			"prettier": { "allowed": false }
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls",
				"!typescript-language-server",
				"..."
			],
			"code_actions_on_format": {
				"source.organizeImports": true,
				"source.organizeImports.biome": true,
				"source.fixAll": true,
				"source.fixAll.biome": true
			},
			"formatter": { "language_server": { "name": "biome" } },
			"prettier": { "allowed": false }
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"!vtsls",
				"!typescript-language-server",
				"..."
			],
			"code_actions_on_format": {
				"source.organizeImports": true,
				"source.organizeImports.biome": true,
				"source.fixAll": true,
				"source.fixAll.biome": true
			},
			"formatter": { "language_server": { "name": "biome" } },
			"prettier": { "allowed": false }
		}
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	}
}
