_S=' ' w='\h';[ "$(id -u)" = 0 ]||w='\[\e[32m\]\u@\h'
PS1='\[\e[1;31m\]${?#0}${_S#?${?#0}}'$w'\[\e[34m\] \w \$\[\e[m\] ';unset w
export LS_COLORS='ex=00:su=00:sg=00:ca=00:'
export EDITOR='busybox vi'
alias ls='ls --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
alias s='doas su'
alias clr='printf "\x1Bc"'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias l='ls -aFlh --group-directories-first'
alias ll='ls -alh'
alias dux='du -bhx --max-depth=1 | sort -h'
