# https://man.openbsd.org/ssh_config

# New key generation example
#$ ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_mozilla_$(date +%Y-%m-%d) -C "Max Milton key for xyz"
#$ ssh-add ~/.ssh/id_...

IgnoreUnknown UseKeychain

# Keep host-specific configuration separate for privacy.
Include hosts.conf

Host *
  # Hash hostnames and addresses added to known_hosts.
  HashKnownHosts yes
  UseKeychain yes
  AddKeysToAgent yes
